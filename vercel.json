{
  "version": 2,
  "builds": [
    {
      "src": "vehicle-sales-frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "build"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/vehicle-sales-frontend/build/index.html"
    }
  ]
}
